# Sowld — copia questo file in .env e compila i valori

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# eBay Browse API (solo se usi --source ebay): crea un'app su
# developer.ebay.com -> My Account -> Application Keys, usa le chiavi di
# produzione ("Production", non "Sandbox") per risultati reali
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Telegram bot (solo se usi --telegram): crea un bot con @BotFather,
# poi scrivigli e recupera il chat_id da https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (solo se usi --email): stesso schema Gmail app password usato dagli
# altri script del repo (outreach.py). DEALS_EMAIL_TO è opzionale, default
# GMAIL_USER (mandi a te stesso).
GMAIL_USER=
GMAIL_APP_PASSWORD=
DEALS_EMAIL_TO=

# --- webapp/ (piattaforma web con abbonamenti) ---

# Firma i cookie di sessione — qualsiasi stringa lunga e casuale va bene,
# generane una nuova per produzione (es. python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=

# Stripe (https://dashboard.stripe.com/test/apikeys) — usa le chiavi "test"
# finché non sei pronto a incassare pagamenti veri
STRIPE_SECRET_KEY=
# Price ID del tuo prodotto in abbonamento (Dashboard -> Product catalog)
STRIPE_PRICE_ID=
# Signing secret del webhook (Dashboard -> Developers -> Webhooks -> la tua
# endpoint -> Signing secret), serve per verificare che gli eventi vengano
# davvero da Stripe
STRIPE_WEBHOOK_SECRET=

# Database utenti — di default un file SQLite locale, va bene per iniziare
DATABASE_URL=sqlite:///./sowld.db
