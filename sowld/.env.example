# Sowld — copia questo file in .env e compila i valori

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Telegram bot (solo se usi --telegram): crea un bot con @BotFather,
# poi scrivigli e recupera il chat_id da https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (solo se usi --email): stesso schema Gmail app password usato dagli
# altri script del repo (outreach.py). DEALS_EMAIL_TO è opzionale, default
# GMAIL_USER (mandi a te stesso).
GMAIL_USER=
GMAIL_APP_PASSWORD=
DEALS_EMAIL_TO=
